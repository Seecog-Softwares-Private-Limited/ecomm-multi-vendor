generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String            @id @default(uuid()) @db.Char(36)
  email                    String            @unique @db.VarChar(255)
  passwordHash             String?           @map("password_hash") @db.VarChar(255)
  firstName                String?           @map("first_name") @db.VarChar(100)
  lastName                 String?           @map("last_name") @db.VarChar(100)
  phone                    String?           @db.VarChar(20)
  /// True once the user has saved a mobile number via the post-login profile step.
  profileCompleted         Boolean           @default(false) @map("profile_completed")
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")
  deletedAt                DateTime?         @map("deleted_at")
  /// Existing accounts default true; new signups set false until email link is clicked.
  emailVerified            Boolean           @default(true) @map("email_verified")
  verificationToken        String?           @map("verification_token") @db.VarChar(64)
  verificationTokenExpires DateTime?         @map("verification_token_expires")
  passwordResetExpires     DateTime?         @map("password_reset_expires")
  passwordResetToken       String?           @map("password_reset_token") @db.VarChar(255)
  avatarUrl                String?           @map("avatar_url") @db.VarChar(500)
  oauthProvider            String?           @map("oauth_provider") @db.VarChar(50)
  oauthProviderId          String?           @map("oauth_provider_id") @db.VarChar(255)
  addresses                Address[]
  cartItems                CartItem[]
  notifications            Notification[]
  orders                   Order[]
  productQuestionsAsked    ProductQuestion[] @relation("ProductQuestionAskedBy")
  reviews                  Review[]
  supportTickets           SupportTicket[]
  supportTicketMessages    SupportTicketMessage[]
  reviewHelpfulVotes       ReviewHelpfulVote[]
  notificationPreference   NotificationPreference?
  wishlistItems            WishlistItem[]
  checkoutSessions         CheckoutSession[]
  /// Incremented on every cart mutation; used to detect stale checkout sessions.
  cartVersion              Int               @default(0) @map("cart_version")

  @@index([email])
  @@index([phone])
  @@index([oauthProvider, oauthProviderId])
  @@index([deletedAt])
  @@map("users")
}

/// One-time codes for customer login via mobile OTP (Amazon/Flipkart-style).
model CustomerPhoneOtp {
  id           String    @id @default(uuid()) @db.Char(36)
  phoneNorm    String    @map("phone_norm") @db.VarChar(20)
  codeHash     String    @map("code_hash") @db.VarChar(128)
  expiresAt    DateTime  @map("expires_at")
  attemptCount Int       @default(0) @map("attempt_count")
  consumedAt   DateTime? @map("consumed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([phoneNorm, expiresAt])
  @@map("customer_phone_otps")
}

model AdminRole {
  id          String    @id @default(uuid()) @db.Char(36)
  name        String    @unique @db.VarChar(100)
  permissions Json
  description String?   @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  admins      Admin[]

  @@index([deletedAt])
  @@map("admin_roles")
}

model Admin {
  id             String              @id @default(uuid()) @db.Char(36)
  email          String              @unique @db.VarChar(255)
  passwordHash   String              @map("password_hash") @db.VarChar(255)
  name           String?             @db.VarChar(255)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  deletedAt      DateTime?           @map("deleted_at")
  phone          String?             @db.VarChar(20)
  roleId         String?             @map("role_id") @db.Char(36)
  status         AdminStatus         @default(INACTIVE)
  approvalStatus AdminApprovalStatus @default(PENDING) @map("approval_status")
  isSuperAdmin           Boolean             @default(false) @map("is_super_admin")
  lastLoginAt            DateTime?           @map("last_login_at")
  passwordResetToken     String?             @map("password_reset_token") @db.VarChar(255)
  passwordResetExpires   DateTime?           @map("password_reset_expires")
  auditLogs              AdminAuditLog[]
  role           AdminRole?          @relation(fields: [roleId], references: [id])
  notifications  Notification[]
  supportTicketMessages SupportTicketMessage[]

  @@index([email])
  @@index([deletedAt])
  @@index([status, approvalStatus])
  @@index([roleId])
  @@map("admins")
}

model AdminAuditLog {
  id        String   @id @default(uuid()) @db.Char(36)
  adminId   String   @map("admin_id") @db.Char(36)
  action    String   @db.VarChar(100)
  module    String   @db.VarChar(100)
  metadata  Json?
  ip        String?  @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([module])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model Seller {
  id                         String                     @id @default(uuid()) @db.Char(36)
  email                      String                     @unique @db.VarChar(255)
  passwordHash               String                     @map("password_hash") @db.VarChar(255)
  businessName               String                     @map("business_name") @db.VarChar(255)
  ownerName                  String                     @map("owner_name") @db.VarChar(255)
  phone                      String?                    @db.VarChar(20)
  businessAddress            String?                    @map("business_address") @db.VarChar(500)
  status                     SellerStatus               @default(PENDING_VERIFICATION)
  createdAt                  DateTime                   @default(now()) @map("created_at")
  updatedAt                  DateTime                   @updatedAt @map("updated_at")
  deletedAt                  DateTime?                  @map("deleted_at")
  profileExtras              String?                    @map("profile_extras") @db.Text
  emailVerified              Boolean                    @default(false) @map("email_verified")
  verificationToken          String?                    @map("verification_token") @db.VarChar(255)
  verificationTokenExpires   DateTime?                  @map("verification_token_expires")
  statusReason               String?                    @map("status_reason") @db.Text
  primaryCategoryId          String?                    @map("primary_category_id") @db.Char(36)
  passwordResetToken         String?                    @map("password_reset_token") @db.VarChar(255)
  passwordResetExpires       DateTime?                  @map("password_reset_expires")
  oauthProvider              String?                    @map("oauth_provider") @db.VarChar(50)
  oauthProviderId            String?                    @map("oauth_provider_id") @db.VarChar(255)
  /// Stable Sign in with Apple user `sub`. Separate from Google oauth_* so both can coexist.
  appleUserId                String?                    @unique @map("apple_user_id") @db.VarChar(255)
  /// When false, catalog treats seller as pan-India (PIN list is stored but ignored). When true, use serviceablePincodes rules.
  restrictDeliveryToPincodes Boolean                    @default(false) @map("restrict_delivery_to_pincodes")
  emailOtpCode               String?                    @map("email_otp_code") @db.VarChar(100)
  emailOtpExpires            DateTime?                  @map("email_otp_expires")
  phoneOtpCode               String?                    @map("phone_otp_code") @db.VarChar(100)
  phoneOtpExpires            DateTime?                  @map("phone_otp_expires")
  phoneVerified              Boolean                    @default(false) @map("phone_verified")
  bankAccounts               BankAccount[]
  kycDocuments               KYCDocument[]
  notifications              Notification[]
  orderItems                 OrderItem[]
  payouts                    Payout[]
  questionsAnswered          ProductQuestion[]          @relation("ProductQuestionAnsweredBy")
  products                   Product[]
  returns                    Return[]
  serviceablePincodes        SellerServiceablePincode[]
  primaryCategory            Category?                  @relation("SellerPrimaryCategory", fields: [primaryCategoryId], references: [id])
  settlements                Settlement[]
  vendorDocuments            VendorDocument[]
  supportTickets             VendorSupportTicket[]

  @@index([email])
  @@index([status])
  @@index([deletedAt])
  @@index([oauthProvider, oauthProviderId])
  @@index([primaryCategoryId])
  @@map("sellers")
}

model VendorSupportTicket {
  id             String              @id @default(uuid()) @db.Char(36)
  sellerId       String              @map("seller_id") @db.Char(36)
  subject        String              @db.VarChar(500)
  category       String              @db.VarChar(100)
  message        String              @db.Text
  status         SupportTicketStatus @default(OPEN)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  deletedAt      DateTime?           @map("deleted_at")
  adminReply     String?             @map("admin_reply") @db.Text
  adminRepliedAt DateTime?           @map("admin_replied_at")
  seller         Seller              @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("vendor_support_tickets")
}

model SellerServiceablePincode {
  id        String   @id @default(uuid()) @db.Char(36)
  sellerId  String   @map("seller_id") @db.Char(36)
  pincode   String   @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, pincode])
  @@index([pincode])
  @@index([sellerId])
  @@map("seller_serviceable_pincodes")
}

/// Single-row config: when restrict is true and the platform PIN list is non-empty, only those PINs are serviceable site-wide (catalog + PDP).
model PlatformDeliveryConfig {
  id                         String   @id @default("default") @db.VarChar(36)
  restrictDeliveryToPincodes Boolean  @default(false) @map("restrict_delivery_to_pincodes")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@map("platform_delivery_config")
}

/// Marketplace-wide serviceable PINs (admin-managed). Ignores per-seller lists when restrict mode is on.
model PlatformServiceablePincode {
  id        String   @id @default(uuid()) @db.Char(36)
  pincode   String   @unique @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([pincode])
  @@map("platform_serviceable_pincodes")
}

model Category {
  id                     String                        @id @default(uuid()) @db.Char(36)
  slug                   String                        @unique @db.VarChar(100)
  name                   String                        @db.VarChar(255)
  sortOrder              Int?                          @default(0) @map("sort_order")
  createdAt              DateTime                      @default(now()) @map("created_at")
  updatedAt              DateTime                      @updatedAt @map("updated_at")
  deletedAt              DateTime?                     @map("deleted_at")
  documentRequirements   CategoryDocumentRequirement[]
  products               Product[]
  primaryCategorySellers Seller[]                      @relation("SellerPrimaryCategory")
  subCategories          SubCategory[]

  @@index([slug])
  @@index([deletedAt])
  @@map("categories")
}

model CategoryDocumentRequirement {
  id           String    @id @default(uuid()) @db.Char(36)
  categoryId   String    @map("category_id") @db.Char(36)
  documentName String    @map("document_name") @db.VarChar(255)
  isRequired   Boolean   @default(true) @map("is_required")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([deletedAt])
  @@map("category_document_requirements")
}

model VendorDocument {
  id           String    @id @default(uuid()) @db.Char(36)
  sellerId     String    @map("seller_id") @db.Char(36)
  documentName String    @map("document_name") @db.VarChar(255)
  documentUrl  String    @map("document_url") @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  seller       Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, documentName])
  @@index([sellerId])
  @@index([deletedAt])
  @@map("vendor_documents")
}

model SubCategory {
  id         String    @id @default(uuid()) @db.Char(36)
  categoryId String    @map("category_id") @db.Char(36)
  slug       String    @db.VarChar(100)
  name       String    @db.VarChar(255)
  sortOrder  Int?      @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  products   Product[]
  category   Category  @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([deletedAt])
  @@map("sub_categories")
}

model Product {
  id              String                 @id @default(uuid()) @db.Char(36)
  sellerId        String                 @map("seller_id") @db.Char(36)
  categoryId      String                 @map("category_id") @db.Char(36)
  subCategoryId   String                 @map("sub_category_id") @db.Char(36)
  name            String                 @db.VarChar(500)
  description     String?                @db.Text
  sku             String                 @db.VarChar(100)
  mrp             Decimal                @db.Decimal(12, 2)
  sellingPrice    Decimal                @map("selling_price") @db.Decimal(12, 2)
  gstPercent      Decimal?               @map("gst_percent") @db.Decimal(5, 2)
  stock           Int                    @default(0)
  returnPolicy    ReturnPolicy           @default(DAYS_7) @map("return_policy")
  status          ProductStatus          @default(DRAFT)
  avgRating       Decimal?               @map("avg_rating") @db.Decimal(3, 2)
  reviewCount     Int?                   @default(0) @map("review_count")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  deletedAt       DateTime?              @map("deleted_at")
  rejectionReason String?                @map("rejection_reason") @db.Text
  slug            String?                @unique @db.VarChar(600)
  cartItems       CartItem[]
  orderItems      OrderItem[]
  images          ProductImage[]
  questions       ProductQuestion[]
  specifications  ProductSpecification[]
  productVariants ProductVariant[]
  variations      ProductVariation[]
  category        Category               @relation(fields: [categoryId], references: [id])
  seller          Seller                 @relation(fields: [sellerId], references: [id])
  subCategory     SubCategory            @relation(fields: [subCategoryId], references: [id])
  reviews         Review[]
  wishlistItems   WishlistItem[]
  checkoutSessionLines CheckoutSessionLine[]
  stockReservations    StockReservation[]

  @@unique([sellerId, sku])
  @@index([sellerId])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([slug])
  @@map("products")
}

model ProductImage {
  id        String    @id @default(uuid()) @db.Char(36)
  productId String    @map("product_id") @db.Char(36)
  url       String    @db.VarChar(500)
  sortOrder Int?      @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([deletedAt])
  @@map("product_images")
}

model ProductSpecification {
  id        String    @id @default(uuid()) @db.Char(36)
  productId String    @map("product_id") @db.Char(36)
  key       String    @db.VarChar(100)
  value     String    @db.VarChar(500)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([deletedAt])
  @@map("product_specifications")
}

model ProductVariation {
  id        String    @id @default(uuid()) @db.Char(36)
  productId String    @map("product_id") @db.Char(36)
  name      String    @db.VarChar(100)
  values    Json
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([deletedAt])
  @@map("product_variations")
}

/// Sellable SKU combinations (e.g. color + size) with dedicated price, stock, optional image.
model ProductVariant {
  id        String    @id @default(uuid()) @db.Char(36)
  productId String    @map("product_id") @db.Char(36)
  color     String?   @db.VarChar(100)
  size      String?   @db.VarChar(100)
  price     Decimal   @db.Decimal(12, 2)
  stock     Int       @default(0)
  sku       String?   @db.VarChar(100)
  image     String?   @db.VarChar(500)
  images    Json?
  sortOrder Int?      @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockReservations StockReservation[]

  @@index([productId])
  @@index([deletedAt])
  @@map("product_variants")
}

model Address {
  id        String      @id @default(uuid()) @db.Char(36)
  userId    String      @map("user_id") @db.Char(36)
  type      AddressType @default(HOME)
  fullName  String      @map("full_name") @db.VarChar(255)
  line1     String      @db.VarChar(255)
  line2     String?     @db.VarChar(255)
  city      String      @db.VarChar(100)
  state     String      @db.VarChar(100)
  pincode   String      @db.VarChar(20)
  phone     String      @db.VarChar(20)
  isDefault Boolean     @default(false) @map("is_default")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  deletedAt DateTime?   @map("deleted_at")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@index([userId])
  @@index([userId, isDefault])
  @@index([deletedAt])
  @@map("addresses")
}

model CartItem {
  id                     String    @id @default(uuid()) @db.Char(36)
  userId                 String    @map("user_id") @db.Char(36)
  productId              String    @map("product_id") @db.Char(36)
  quantity               Int       @default(1)
  variantKey             String?   @map("variant_key") @db.VarChar(255)
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  deletedAt              DateTime? @map("deleted_at")
  /// Unit selling price captured when the line was added (shopper-visible; survives vendor edits pending approval).
  listedUnitSellingPrice Decimal?  @map("listed_unit_selling_price") @db.Decimal(12, 2)
  listedUnitMrp          Decimal?  @map("listed_unit_mrp") @db.Decimal(12, 2)
  savedForLater          Boolean   @default(false) @map("saved_for_later")
  product                Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkoutSessionLines   CheckoutSessionLine[]

  @@unique([userId, productId, variantKey])
  @@index([userId])
  @@index([productId])
  @@index([deletedAt])
  @@index([userId, savedForLater])
  @@map("cart_items")
}

model WishlistItem {
  id                 String    @id @default(uuid()) @db.Char(36)
  userId             String    @map("user_id") @db.Char(36)
  productId          String    @map("product_id") @db.Char(36)
  variantKey         String?   @map("variant_key") @db.VarChar(255)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")
  listedSellingPrice Decimal?  @map("listed_selling_price") @db.Decimal(12, 2)
  listedMrp          Decimal?  @map("listed_mrp") @db.Decimal(12, 2)
  product            Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@index([deletedAt])
  @@map("wishlist_items")
}

model Order {
  id                String             @id @default(uuid()) @db.Char(36)
  userId            String             @map("user_id") @db.Char(36)
  shippingAddressId String             @map("shipping_address_id") @db.Char(36)
  couponId          String?            @map("coupon_id") @db.Char(36)
  status            OrderStatus        @default(PLACED)
  totalAmount       Decimal            @map("total_amount") @db.Decimal(12, 2)
  discountAmount    Decimal?           @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount         Decimal?           @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  shippingAmount    Decimal?           @default(0.00) @map("shipping_amount") @db.Decimal(12, 2)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  items             OrderItem[]
  statusEvents      OrderStatusEvent[]
  coupon            Coupon?            @relation(fields: [couponId], references: [id])
  shippingAddress   Address            @relation(fields: [shippingAddressId], references: [id])
  user              User               @relation(fields: [userId], references: [id])
  payments          Payment[]
  returns           Return[]
  supportTickets    SupportTicket[]
  checkoutSession   CheckoutSession? @relation(fields: [checkoutSessionId], references: [id])
  checkoutSessionId String?          @unique @map("checkout_session_id") @db.Char(36)
  /// Cart line IDs consumed when this order was placed (CART / REORDER flows).
  consumedCartItemIds Json?          @map("consumed_cart_item_ids")
  idempotencyKey    String?          @unique @map("idempotency_key") @db.VarChar(64)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([couponId], map: "orders_coupon_id_fkey")
  @@index([shippingAddressId], map: "orders_shipping_address_id_fkey")
  @@map("orders")
}

model OrderItem {
  id                String          @id @default(uuid()) @db.Char(36)
  orderId           String          @map("order_id") @db.Char(36)
  productId         String          @map("product_id") @db.Char(36)
  sellerId          String          @map("seller_id") @db.Char(36)
  quantity          Int
  unitPrice         Decimal         @map("unit_price") @db.Decimal(12, 2)
  totalPrice        Decimal         @map("total_price") @db.Decimal(12, 2)
  status            OrderItemStatus @default(NEW)
  variantSnapshot   Json?           @map("variant_snapshot")
  sku               String?         @db.VarChar(100)
  commissionPercent Decimal?        @map("commission_percent") @db.Decimal(5, 2)
  commissionAmount  Decimal?        @map("commission_amount") @db.Decimal(12, 2)
  netPayable        Decimal?        @map("net_payable") @db.Decimal(12, 2)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id])
  seller            Seller          @relation(fields: [sellerId], references: [id])
  returnItems       ReturnItem[]

  @@index([orderId])
  @@index([productId])
  @@index([sellerId])
  @@index([status])
  @@map("order_items")
}

model OrderStatusEvent {
  id         String      @id @default(uuid()) @db.Char(36)
  orderId    String      @map("order_id") @db.Char(36)
  status     OrderStatus
  note       String?     @db.VarChar(500)
  occurredAt DateTime    @default(now()) @map("occurred_at")
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([orderId, occurredAt])
  @@map("order_status_events")
}

model Payment {
  id            String        @id @default(uuid()) @db.Char(36)
  orderId       String        @map("order_id") @db.Char(36)
  mode          PaymentMode
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(12, 2)
  transactionId String?       @map("transaction_id") @db.VarChar(255)
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  order           Order         @relation(fields: [orderId], references: [id])
  idempotencyKey  String?       @unique @map("idempotency_key") @db.VarChar(64)
  razorpayOrderId String?       @map("razorpay_order_id") @db.VarChar(255)

  @@index([orderId])
  @@index([status])
  @@index([transactionId])
  @@index([razorpayOrderId])
  @@map("payments")
}

model Coupon {
  id            String    @id @default(uuid()) @db.Char(36)
  code          String    @unique @db.VarChar(50)
  discountType  String    @map("discount_type") @db.VarChar(20)
  discountValue Decimal   @map("discount_value") @db.Decimal(10, 2)
  validFrom     DateTime  @map("valid_from")
  validTo       DateTime  @map("valid_to")
  maxUses       Int?      @map("max_uses")
  usedCount     Int?      @default(0) @map("used_count")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  orders        Order[]

  @@index([code])
  @@index([validFrom, validTo])
  @@index([deletedAt])
  @@map("coupons")
}

model Return {
  id          String       @id @default(uuid()) @db.Char(36)
  orderId     String       @map("order_id") @db.Char(36)
  sellerId    String       @map("seller_id") @db.Char(36)
  totalAmount Decimal      @map("total_amount") @db.Decimal(12, 2)
  reason      String       @db.VarChar(500)
  status      ReturnStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")
  returnItems ReturnItem[]
  order       Order        @relation(fields: [orderId], references: [id])
  seller      Seller       @relation(fields: [sellerId], references: [id])

  @@index([orderId])
  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("returns")
}

model ReturnItem {
  id           String    @id @default(uuid()) @db.Char(36)
  returnId     String    @map("return_id") @db.Char(36)
  orderItemId  String    @map("order_item_id") @db.Char(36)
  quantity     Int
  refundAmount Decimal   @map("refund_amount") @db.Decimal(12, 2)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id])
  return       Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@unique([returnId, orderItemId])
  @@index([returnId])
  @@index([orderItemId])
  @@map("return_items")
}

model SupportTicket {
  id             String              @id @default(uuid()) @db.Char(36)
  userId         String              @map("user_id") @db.Char(36)
  orderId        String?             @map("order_id") @db.Char(36)
  subject        String              @db.VarChar(500)
  status         SupportTicketStatus @default(OPEN)
  lastUpdateAt   DateTime?           @map("last_update_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  deletedAt      DateTime?           @map("deleted_at")
  adminRepliedAt DateTime?           @map("admin_replied_at")
  adminReply     String?             @map("admin_reply") @db.Text
  order          Order?              @relation(fields: [orderId], references: [id])
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       SupportTicketMessage[]

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id         String                 @id @default(uuid()) @db.Char(36)
  ticketId   String                 @map("ticket_id") @db.Char(36)
  authorType SupportMessageAuthor   @map("author_type")
  body       String                 @db.Text
  userId     String?                @map("user_id") @db.Char(36)
  adminId    String?                @map("admin_id") @db.Char(36)
  createdAt  DateTime               @default(now()) @map("created_at")
  ticket     SupportTicket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user       User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  admin      Admin?                 @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([userId])
  @@map("support_ticket_messages")
}

model Review {
  id           String    @id @default(uuid()) @db.Char(36)
  productId    String    @map("product_id") @db.Char(36)
  userId       String    @map("user_id") @db.Char(36)
  rating       Int
  comment      String?   @db.Text
  verified     Boolean   @default(false)
  helpfulCount Int?      @default(0) @map("helpful_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  helpfulVotes ReviewHelpfulVote[]

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("reviews")
}

model ReviewHelpfulVote {
  id        String   @id @default(uuid()) @db.Char(36)
  reviewId  String   @map("review_id") @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@index([userId])
  @@map("review_helpful_votes")
}

model Faq {
