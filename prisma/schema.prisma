  amount      Decimal      @db.Decimal(14, 2)
  status      PayoutStatus @default(PENDING)
  paidAt      DateTime?    @map("paid_at")
  reference   String?      @db.VarChar(255)
  ordersCount Int?         @map("orders_count")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  seller      Seller       @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
  @@index([status])
  @@index([paidAt])
  @@map("payouts")
}

model Notification {
  id        String           @id @default(uuid()) @db.Char(36)
  type      NotificationType
  title     String           @db.VarChar(255)
  message   String           @db.Text
  userId    String?          @map("user_id") @db.Char(36)
  sellerId  String?          @map("seller_id") @db.Char(36)
  adminId   String?          @map("admin_id") @db.Char(36)
  read      Boolean          @default(false)
  readAt    DateTime?        @map("read_at")
  /// Optional deep-link metadata: orderId, productId, actionHref, actionLabel
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  deletedAt DateTime?        @map("deleted_at")
  admin     Admin?           @relation(fields: [adminId], references: [id], onDelete: Cascade)
  seller    Seller?          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sellerId])
  @@index([adminId])
  @@index([read])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("notifications")
}

model CmsFooterPage {
  id        String   @id @default(uuid()) @db.Char(36)
  slug      String   @unique @db.VarChar(120)
  sectionId String   @map("section_id") @db.VarChar(80)
  title     String   @db.VarChar(255)
  /// Trusted HTML from admins only (rendered with dangerouslySetInnerHTML on /info/[slug]).
  content   String   @db.LongText
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sectionId])
  @@map("cms_footer_pages")
}

/// Published job cards on the storefront /info/careers page (admin CRUD).
model CareerOpening {
  id             String   @id @default(uuid()) @db.Char(36)
  title          String   @db.VarChar(255)
  department     String   @db.VarChar(255)
  location       String   @db.VarChar(255)
  employmentType String   @map("employment_type") @db.VarChar(120)
  /// When false, hidden from the careers page (still editable in admin).
  published      Boolean  @default(true)
  /// Lower sorts first.
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  /// Full role description (plain text); shown when visitors open job details on the careers page.
  description    String?  @db.Text

  @@index([published, sortOrder])
  @@map("career_openings")
}

/// Time-limited checkout intent (cart selection, buy now, or reorder).
model CheckoutSession {
  id               String                @id @db.Char(36)
  userId           String                @map("user_id") @db.Char(36)
  type             CheckoutSessionType
  status           CheckoutSessionStatus @default(ACTIVE)
  cartVersion      Int                   @map("cart_version")
  expiresAt        DateTime              @map("expires_at")
  idempotencyKey   String?               @unique @map("idempotency_key") @db.VarChar(64)
  priceConfirmedAt DateTime?             @map("price_confirmed_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order            Order?
  lines            CheckoutSessionLine[]
  stockReservations StockReservation[]

  @@index([userId])
  @@index([userId, status])
  @@index([expiresAt])
  @@index([status])
  @@map("checkout_sessions")
}

model CheckoutSessionLine {
  id                 String          @id @default(uuid()) @db.Char(36)
  checkoutSessionId  String          @map("checkout_session_id") @db.Char(36)
  cartItemId         String?         @map("cart_item_id") @db.Char(36)
  productId          String          @map("product_id") @db.Char(36)
  sellerId           String          @map("seller_id") @db.Char(36)
  variantKey         String?         @map("variant_key") @db.VarChar(255)
  quantity           Int
  unitSellingPrice   Decimal         @map("unit_selling_price") @db.Decimal(12, 2)
  unitMrp            Decimal?        @map("unit_mrp") @db.Decimal(12, 2)
  createdAt          DateTime        @default(now()) @map("created_at")
  checkoutSession    CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  cartItem           CartItem?       @relation(fields: [cartItemId], references: [id], onDelete: SetNull)
  product            Product         @relation(fields: [productId], references: [id])

  @@index([checkoutSessionId])
  @@index([cartItemId])
  @@index([productId])
  @@index([sellerId])
  @@map("checkout_session_lines")
}

model StockReservation {
  id                String                  @id @default(uuid()) @db.Char(36)
  checkoutSessionId String                  @map("checkout_session_id") @db.Char(36)
  productId         String                  @map("product_id") @db.Char(36)
  productVariantId  String?                 @map("product_variant_id") @db.Char(36)
  variantKey        String?                 @map("variant_key") @db.VarChar(255)
  quantity          Int
  status            StockReservationStatus  @default(ACTIVE)
  expiresAt         DateTime                @map("expires_at")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  checkoutSession   CheckoutSession         @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  product           Product                 @relation(fields: [productId], references: [id])
  productVariant    ProductVariant?         @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([checkoutSessionId])
  @@index([productId])
  @@index([status, expiresAt])
  @@map("stock_reservations")
}

enum CheckoutSessionType {
  CART
  BUY_NOW
  REORDER
}

enum CheckoutSessionStatus {
  ACTIVE
  CHECKING_OUT
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

enum StockReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum SellerStatus {
  PENDING_VERIFICATION
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  ON_HOLD
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  INACTIVE
}

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  PAYMENT_CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum OrderItemStatus {
