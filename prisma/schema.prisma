  REJECTED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMode {
  PREPAID
  COD
  WALLET
  CARD
  UPI
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum AddressType {
  HOME
  OFFICE
  OTHER
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportMessageAuthor {
  CUSTOMER
  ADMIN
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

enum KYCStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KYCDocumentType {
  PAN
  GST_CERTIFICATE
  ADDRESS_PROOF
}

enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
}

enum PayoutStatus {
