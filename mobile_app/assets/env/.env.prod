APP_ENV=prod
LOG_NETWORK=false

# Production — same host on every platform.
BASE_URL_IOS=https://indovyapar.com
BASE_URL_ANDROID=https://indovyapar.com
BASE_URL=https://indovyapar.com

# Web OAuth client ID = backend audience (serverClientId). Do NOT replace with Android client ID.
GOOGLE_SERVER_CLIENT_ID=346062297276-iq1p66fiqcppd0e8k2oqjtlbp5ku899h.apps.googleusercontent.com
# Android OAuth client is registered in Google Cloud (package + SHA-1); not used as serverClientId.
# GOOGLE_ANDROID_CLIENT_ID=346062297276-of6s1ddg6dn8qfsuhs30qpnsu5j172ii.apps.googleusercontent.com
